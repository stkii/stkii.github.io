{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": {
	"enabled": false,
	"clientKind": "git",
	"useIgnoreFile": false
  },
  "files": {
    "includes": ["docs/**/*.html", "docs/**/*.css", "docs/**/*.js"]
  },
  "assist": {
	"enabled": true,
	"actions": {
	  "source": {
		"organizeImports": "on"
	  }
	}
  },
  // Language-specific formatting options below
  "css": {
	"formatter": {
	  "enabled": true,
	  "quoteStyle": "single"
	}
  },
  "html": {
    "formatter": {
		"enabled": true,
		"indentStyle": "space",
		"indentWidth": 2,
		"lineWidth": 320
	}
  },
  "javascript": {
	"formatter": {
	  "enabled": true,
	  "quoteStyle": "single",
	  "trailingCommas": "es5"
	}
  }
}
